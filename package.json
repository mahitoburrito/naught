{
  "name": "@mahitoburrito/openui-desktop",
  "version": "1.0.9",
  "description": "AI Agent Command Center \u2014 Desktop App",
  "main": "dist/electron/electron/main.js",
  "author": "mahitoburrito <mahitraj@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahitoburrito/openui-desktop.git"
  },
  "homepage": "https://github.com/mahitoburrito/openui-desktop#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "openui",
    "desktop",
    "electron",
    "terminal",
    "canvas"
  ],
  "bin": {
    "openui-desktop": "./bin/openui-desktop",
    "openui-control": "./bin/openui-control.js",
    "naught": "./bin/naught.js"
  },
  "files": [
    "bin/",
    "server/",
    "resources/",
    "client/dist/",
    "claude-code-plugin/",
    "dist/",
    "tsconfig.electron.json",
    "README.md"
  ],
  "scripts": {
    "dev": "VITE_PORT=5173 SERVER_PORT=6969 concurrently --kill-others \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:client": "cd client && SERVER_PORT=${SERVER_PORT:-6968} npx vite --port ${VITE_PORT:-5173} --strictPort",
    "dev:electron": "tsc -p tsconfig.electron.json && VITE_PORT=${VITE_PORT:-5173} PORT=${SERVER_PORT:-6968} electron .",
    "build:client": "cd client && npx vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:client && npm run build:electron",
    "test:features": "npm run build && node scripts/smoke-openui-features.mjs",
    "test:status": "npm run build:electron && node scripts/test-agent-status.mjs",
    "test:coordinator": "npm run build:electron && node scripts/test-coordinator.mjs",
    "start": "node bin/openui-desktop.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "prepublishOnly": "npm run build",
    "postinstall": "npm ci --prefix client && node scripts/fix-node-pty-permissions.mjs",
    "test:teardown": "npm run build:electron && node scripts/smoke-session-teardown.mjs",
    "test:devboxes": "npm run build:electron && node scripts/test-devboxes.mjs",
    "test:compute": "npm run build:electron && node scripts/test-compute.mjs",
    "test:naught": "node scripts/test-naught-cli.mjs",
    "test:manifest": "bash scripts/test-manifest-py.sh",
    "test:move": "npm run build:electron && node scripts/test-move.mjs",
    "test:move:docker": "npm run build:electron && node scripts/test-move-docker.mjs",
    "smoke:compute-live": "npm run build:electron && node scripts/smoke-compute-live.mjs",
    "smoke:move-live": "npm run build:electron && node scripts/smoke-move-live.mjs",
    "test:coordinator-agent": "npm run build:electron && node scripts/test-coordinator-agent.mjs",
    "smoke:agent-move-live": "npm run build:electron && node scripts/smoke-agent-move-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.0.8",
    "electron-updater": "^6.8.9",
    "hono": "^4.12.28",
    "modal": "^0.7.2",
    "node-pty": "^1.0.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.14",
    "concurrently": "^10.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "com.openui.desktop",
    "productName": "OpenUI",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "bin/openui-control.js",
      "bin/naught.js",
      "dist/**/*",
      "client/dist/**/*",
      "claude-code-plugin/**/*",
      "resources/**/*"
    ],
    "icon": "resources/icon",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "executableName": "openui",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "claude-code-plugin",
        "to": "claude-code-plugin"
      },
      {
        "from": "resources/shell-integration",
        "to": "shell-integration"
      },
      {
        "from": "resources/remote-terminal",
        "to": "remote-terminal"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mahitoburrito",
      "repo": "openui-desktop"
    }
  }
}
